# ---------------------------------------------------------------------------
# Judicial Chambers — PHP application configuration
# In production, supply secrets through the process environment or a secrets
# manager rather than this file. Never commit a real .env.
# ---------------------------------------------------------------------------
APP_NAME="Judicial Chambers"
# production | development  (production enforces HTTPS, TLS to MySQL, secure cookies)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://chambers.example.court.zm
APP_TIMEZONE=Africa/Lusaka
# Comma-separated IPs of reverse proxies allowed to set X-Forwarded-Proto/For
TRUSTED_PROXIES=127.0.0.1

# --- Database (MySQL 8 over TLS) ---------------------------------------------
DB_DSN="mysql:host=db.internal;port=3306;dbname=judicial_chambers;charset=utf8mb4"
DB_USER=jc_app
DB_PASS=change-me
# CA that signed the MySQL server certificate. Required in production unless
# connecting through a local unix_socket.
DB_SSL_CA=/etc/judicial-chambers/tls/mysql-ca.pem
DB_SSL_VERIFY=true
# Optional mutual TLS
#DB_SSL_CERT=/etc/judicial-chambers/tls/mysql-client.pem
#DB_SSL_KEY=/etc/judicial-chambers/tls/mysql-client.key

# --- Encryption at rest -------------------------------------------------------
# Master key ring: "id:base64(32 bytes)" entries, comma separated.
# Generate a key with:  php bin/jc keys:generate
# Keep retired keys in the ring until `php bin/jc keys:rotate` has run.
KEYRING=
ACTIVE_KEY_ID=

# --- Transcription service (Node.js) -------------------------------------------
# Shared HMAC secret for PHP <-> Node request signing and capture tokens.
# Generate with:  php bin/jc secret:generate   (must match transcription/.env)
SERVICE_HMAC_SECRET=
# Public WSS endpoint used by browsers (must be wss:// in production)
TRANSCRIPTION_PUBLIC_URL=wss://transcribe.example.court.zm
# Internal HTTPS endpoint PHP uses to queue re-transcription jobs
TRANSCRIPTION_INTERNAL_URL=https://transcription.internal:8443
# Shown to users on the recording and review pages: who performs speech-to-text
TRANSCRIPTION_PROCESSOR="AssemblyAI (external processor, TLS)"
# CA bundle for the internal transcription endpoint (if privately issued)
#TRANSCRIPTION_CA_FILE=/etc/judicial-chambers/tls/internal-ca.pem

# --- Storage ------------------------------------------------------------------
# Encrypted documents and recordings. Must be shared with the transcription
# service (it writes recordings/). Only ciphertext is ever written here.
STORAGE_PATH=/var/lib/judicial-chambers/storage
MAX_UPLOAD_MB=100

# --- Sessions & authentication ----------------------------------------------------
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
MFA_REQUIRED_ROLES=judge,marshal,clerk,judicial_assistant,researcher,court_reporter
