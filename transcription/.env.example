# ---------------------------------------------------------------------------
# Judicial Chambers — transcription service configuration
# ---------------------------------------------------------------------------
# production enforces TLS, https callbacks and an Origin allow-list
APP_ENV=production
HOST=0.0.0.0
PORT=8443

# --- Data in transit ----------------------------------------------------------
TLS_CERT=/etc/judicial-chambers/tls/transcription.fullchain.pem
TLS_KEY=/etc/judicial-chambers/tls/transcription.key
# Optional: require a client certificate (mTLS) for POST /jobs from PHP
#TLS_CA=/etc/judicial-chambers/tls/internal-ca.pem
# Browser origin(s) allowed to open capture sockets
ALLOWED_ORIGINS=https://chambers.example.court.zm

# --- Shared with the PHP application (must be identical) -----------------------
KEYRING=
ACTIVE_KEY_ID=
SERVICE_HMAC_SECRET=
# The PHP application, reached over HTTPS, for signed callbacks
PHP_INTERNAL_URL=https://chambers.example.court.zm

# --- Storage ------------------------------------------------------------------
# Same STORAGE_PATH as the PHP app; recordings are written (encrypted) to ./recordings
STORAGE_PATH=/var/lib/judicial-chambers/storage
# RAM-backed directory for the few seconds a speech engine needs a WAV file
SECURE_TMP_DIR=/dev/shm

# --- Speech-to-text -------------------------------------------------------------
# Default engine: assemblyai | whisper-cpp | http | mock
ASR_PROVIDER=assemblyai
# Route particular hearing languages to another engine, e.g. a self-hosted
# Zambian-language model behind HTTP_ASR_URL:
#ASR_LANGUAGE_ROUTES=bem:http,nya:http,toi:http,loz:http
# Languages with no capable engine are recorded and sealed but not machine-transcribed.

# AssemblyAI — an EXTERNAL processor: court audio leaves your infrastructure.
# Required in production, and only after the transfer is approved
# (Data Protection Act 2021 assessment + data processing agreement):
EXTERNAL_ASR_APPROVED=false
ASSEMBLYAI_API_KEY=
# Use the regional endpoints named in your AssemblyAI contract if different
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
ASSEMBLYAI_STREAMING_URL=wss://streaming.assemblyai.com/v3/ws
# Real-time draft in the recording console (Universal-Streaming)
ASSEMBLYAI_LIVE=true
ASSEMBLYAI_STREAMING_MODEL=universal-streaming-english
# Optional batch model priority list, e.g. universal
#ASSEMBLYAI_SPEECH_MODELS=
# Vocabulary hints for court proceedings (comma separated)
ASSEMBLYAI_KEYTERMS=My Lord,My Lady,Your Honour,affidavit,plaintiff,defendant,appellant,respondent,adjournment,exhibit,cross-examination,Lusaka,Ndola,Kitwe
ASSEMBLYAI_TIMEOUT_MINUTES=120
# After sealing, transcribe the whole hearing in one pass (consistent speaker
# diarization) and replace the live draft. Human corrections are kept.
ASR_FINAL_PASS=true

# Local engines (no audio leaves the machine / court network)
#WHISPER_CPP_BIN=/opt/whisper.cpp/build/bin/whisper-cli
#WHISPER_CPP_MODEL=/opt/whisper.cpp/models/ggml-large-v3-turbo.bin
#WHISPER_CPP_THREADS=8
# Self-hosted OpenAI-compatible endpoint; receives `language` as en / bem / nya / toi / loz
#HTTP_ASR_URL=https://asr.internal/v1/audio/transcriptions
#HTTP_ASR_MODEL=zambezi-voice-xlsr
#HTTP_ASR_API_KEY=
ASR_CONCURRENCY=1
LIVE_WINDOW_SECONDS=20
JOB_WINDOW_SECONDS=30

# Seal a recording automatically if the courtroom has not reconnected after this long
SESSION_GRACE_MINUTES=30
