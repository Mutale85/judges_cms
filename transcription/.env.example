# ---------------------------------------------------------------------------
# Judicial Chambers — transcription service configuration
# ---------------------------------------------------------------------------
# production enforces TLS, https callbacks and an Origin allow-list
APP_ENV=production
HOST=0.0.0.0
PORT=8443

# --- Data in transit ----------------------------------------------------------
TLS_CERT=/etc/judicial-chambers/tls/transcription.fullchain.pem
TLS_KEY=/etc/judicial-chambers/tls/transcription.key
# Optional: require a client certificate (mTLS) for POST /jobs from PHP
#TLS_CA=/etc/judicial-chambers/tls/internal-ca.pem
# Browser origin(s) allowed to open capture sockets
ALLOWED_ORIGINS=https://chambers.example.court.zm

# --- Shared with the PHP application (must be identical) -----------------------
KEYRING=
ACTIVE_KEY_ID=
SERVICE_HMAC_SECRET=
# The PHP application, reached over HTTPS, for signed callbacks
PHP_INTERNAL_URL=https://chambers.example.court.zm

# --- Storage ------------------------------------------------------------------
# Same STORAGE_PATH as the PHP app; recordings are written (encrypted) to ./recordings
STORAGE_PATH=/var/lib/judicial-chambers/storage
# RAM-backed directory for the few seconds a speech engine needs a WAV file
SECURE_TMP_DIR=/dev/shm

# --- Speech-to-text -------------------------------------------------------------
# mock | whisper-cpp | http
ASR_PROVIDER=whisper-cpp
WHISPER_CPP_BIN=/opt/whisper.cpp/build/bin/whisper-cli
WHISPER_CPP_MODEL=/opt/whisper.cpp/models/ggml-large-v3-turbo.bin
WHISPER_CPP_THREADS=8
# For ASR_PROVIDER=http (self-hosted OpenAI-compatible endpoint, e.g. speaches / faster-whisper-server)
#HTTP_ASR_URL=https://asr.internal/v1/audio/transcriptions
#HTTP_ASR_MODEL=Systran/faster-whisper-large-v3
#HTTP_ASR_API_KEY=
ASR_CONCURRENCY=1
LIVE_WINDOW_SECONDS=20
JOB_WINDOW_SECONDS=30

# Seal a recording automatically if the courtroom has not reconnected after this long
SESSION_GRACE_MINUTES=30
